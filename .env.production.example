# ===============================================
# إعدادات بيئة الإنتاج على الخادم (Production Env)
# ===============================================

# 1. إعدادات قاعدة البيانات PostgreSQL في الدوكر
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=inventory_db
POSTGRES_PORT=5434

# 2. مفتاح الأمان للتشفير والرموز JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=12h

# 3. المنفذ الخاص بالتطبيق
PORT=3000

# 4. مفاتيح اختيارية (Gemini AI / Firebase)
GEMINI_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
