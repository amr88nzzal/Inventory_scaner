DATABASE_URL="postgresql://inventory:inventory@localhost:5432/inventory_audit?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="12h"
PORT=4000
UPLOAD_DIR="./uploads"

# Firebase Cloud Messaging (push notifications). Provide EITHER the raw
# service-account JSON below (recommended for Docker) OR set
# GOOGLE_APPLICATION_CREDENTIALS to a mounted file path instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
