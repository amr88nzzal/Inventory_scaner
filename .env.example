# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Prisma PostgreSQL database connection string.
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# JWT_SECRET: Secret key used to sign and verify JWT tokens.
JWT_SECRET="some-very-secure-secret-key-at-least-32-chars"

# JWT_EXPIRES_IN: JWT token expiration time. Defaults to "12h".
JWT_EXPIRES_IN="12h"

# FIREBASE_SERVICE_ACCOUNT_JSON: Firebase service account raw JSON string for Push Notifications.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}'
